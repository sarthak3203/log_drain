# Neon PostgreSQL
DATABASE_URL=postgresql://username:password@your-neon-endpoint-pooler.neon.tech/neondb?sslmode=require&channel_binding=require

# Upstash Redis REST
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=<REPLACE_WITH_UPSTASH_REST_TOKEN>

# Neon-friendly PostgreSQL pool tuning
PG_POOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=10000

# User-session JWT signing secret. Must be at least 32 characters; generate with `openssl rand -base64 32`.
JWT_SECRET=<REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS>

# Public frontend origin used by Express CORS.
# Examples: http://203.0.113.10 or https://logs.example.com
FRONTEND_URL=https://<YOUR_DOMAIN_OR_IP>

# OpenAI-compatible LLM/embedding provider
GEMINI_API_KEY=<REDACTED_PROVIDER_API_KEY>
AICREDITS_BASE_URL=https://api.aicredits.in/v1


# Frontend build-time API URL. Keep relative when frontend and API share a domain.
VITE_API_URL=/api/v1
