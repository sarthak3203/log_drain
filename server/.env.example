# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://username:password@localhost:5433/database_name

# Local Docker Redis (development only)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# OpenAI-compatible LLM/embedding provider
GEMINI_API_KEY=your-api-key-here
AICREDITS_BASE_URL=https://api.aicredits.in/v1
EMBEDDING_MODEL=text-embedding-3-small

# Python ML anomaly detection service
PYTHON_ML_URL=http://localhost:8000

# PostgreSQL pool tuning. Neon-friendly defaults are used when omitted.
PG_POOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=10000

# LangSmith / LangChain tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=log-drain-dev
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
